# SPDX-License-Identifier: MIT OR Apache-2.0

[package]
name = "arm-sysregs-common"
version = "0.5.2"
edition = "2024"
license = "MIT OR Apache-2.0"
description = "Common macros for the Armv8-A system register crates"
repository = "https://git.trustedfirmware.org/arm-firmware-crates/arm-sysregs.git"
authors = ["Andrew Walbran <qwandor@google.com>"]
keywords = ["arm", "aarch64", "sysregs", "system", "registers"]
categories = ["hardware-support", "embedded", "no-std", "no-std::no-alloc"]
readme = "README.md"
rust-version = "1.88"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[dependencies]
bitflags = { workspace = true }
pastey = "0.2.3"
num_enum = { version = "0.7.6", default-features = false }

[features]
fakes = []

[lints]
workspace = true
